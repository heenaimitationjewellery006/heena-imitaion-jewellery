# Flask Configuration
SECRET_KEY=change_me_to_a_random_string

# Supabase / PostgreSQL Database Connection (Automatically set by Netlify Supabase Integration)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Admin Credentials
ADMIN_ID=your_admin_id
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_WHATSAPP_NUMBER=91XXXXXXXXXX

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Order Notifications (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password

# Customer WhatsApp Support Button (Optional)
WHATSAPP_NUMBER=91XXXXXXXXXX
